<UserControl x:Class="MVVM_Lab1.UserControls.TriggersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:MVVM_Lab1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:TriggersViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="{Binding Localization[TriggersTitle]}" 
                       Grid.Row="0"
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Пример 1: Property Trigger -->
            <GroupBox Header="{Binding Localization[PropertyTrigger]}" 
                      Grid.Row="1" 
                      Margin="0,0,0,20" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[PropertyTriggerDesc]}" 
                               Margin="5" Foreground="Gray"/>

                    <Button Content="{Binding Localization[HoverButton]}"
                            Width="200" Height="40"
                            Margin="5"
                            HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="LightBlue"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="Black"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Orange"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding Localization[PropertyTriggerInfo]}" 
                               Margin="5,10,5,5" 
                               Foreground="Green" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <!-- Пример 2: Data Trigger -->
            <GroupBox Header="{Binding Localization[DataTrigger]}" 
                      Grid.Row="2" 
                      Margin="0,0,0,20" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[DataTriggerDesc]}" 
                               Margin="5" Foreground="Gray"/>

                    <CheckBox Content="{Binding Localization[EnableSpecialModeTrigger]}"
                              IsChecked="{Binding IsSpecialMode}"
                              Margin="5"/>

                    <Border BorderThickness="2" 
                            CornerRadius="5"
                            Margin="5,10,5,5"
                            Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="LightGray"/>
                                <Setter Property="BorderBrush" Value="Gray"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpecialMode}" Value="True">
                                        <Setter Property="Background" Value="Gold"/>
                                        <Setter Property="BorderBrush" Value="Orange"/>
                                        <Setter Property="BorderThickness" Value="3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding StatusText}" 
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding Localization[DataTriggerInfo]}" 
                               Margin="5,10,5,5" 
                               Foreground="Green" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <!-- Пример 3: Multi Trigger -->
            <GroupBox Header="{Binding Localization[MultiTrigger]}" 
                      Grid.Row="3" 
                      Margin="0,0,0,20" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[MultiTriggerDesc]}" 
                               Margin="5" Foreground="Gray"/>

                    <Button Content="{Binding Localization[HoverAndPress]}"
                            Width="200" Height="40"
                            Margin="5"
                            HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="LightGreen"/>
                                <Setter Property="FontSize" Value="14"/>

                                <Style.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsPressed" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="Red"/>
                                        <Setter Property="FontSize" Value="20"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding Localization[MultiTriggerInfo]}" 
                               Margin="5,10,5,5" 
                               Foreground="Green" FontSize="11"/>
                </StackPanel>
            </GroupBox>

            <!-- Пример 4: DataTrigger с прогрессом и командами -->
            <GroupBox Header="{Binding Localization[DataTriggerProgress]}" 
                      Grid.Row="4" 
                      Margin="0,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[DataTriggerProgressDesc]}" 
                               Margin="5" Foreground="Gray"/>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Localization[ProgressPercent]}"/>
                            <ProgressBar Minimum="0" Maximum="100" 
                                         Value="{Binding ProgressValue}"
                                         Height="25" Margin="0,5"/>
                            <TextBlock Text="{Binding ProgressValue, StringFormat={}{0}%}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="{Binding Localization[Increase10]}" 
                                    Command="{Binding IncreaseProgressCommand}"
                                    IsEnabled="{Binding IsButtonEnabled}"
                                    Width="80" Height="30"
                                    Margin="0,0,0,5"/>
                            <Button Content="{Binding Localization[Reset]}" 
                                    Command="{Binding ResetCommand}"
                                    Width="80" Height="30"/>
                        </StackPanel>
                    </Grid>

                    <Border Margin="5,10,5,5" 
                            Padding="10"
                            CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="LightGray"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressValue}" Value="100">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsSpecialMode}" Value="True">
                                        <Setter Property="Background" Value="LightYellow"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding StatusText}" 
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding Localization[DataTriggerProgressInfo]}" 
                               Margin="5,10,5,5" 
                               Foreground="Green" FontSize="11"/>

                    <TextBlock Text="{Binding Localization[CommandInfo]}" 
                               Margin="5,0,5,5" 
                               Foreground="Blue" FontSize="11"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>