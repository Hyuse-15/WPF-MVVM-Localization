<UserControl x:Class="MVVM_Lab1.UserControls.OneWayBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:MVVM_Lab1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:OneWayBindingViewModel />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="{Binding Localization[OneWayBindingTitle]}" 
                   Grid.Row="0"
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Пояснение -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Localization[OneWayBindingDescription]}"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,15"/>

        <!-- Группа с OneWay привязками -->
        <GroupBox Header="{Binding Localization[OneWayDataGroup]}" 
                  Grid.Row="2"
                  Margin="0,0,0,20" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5">
                    <TextBlock Text="{Binding Localization[Status]}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               TextWrapping="Wrap"
                               Background="LightYellow"
                               Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,15">
                    <TextBlock Text="{Binding Localization[OperationCounter]}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Counter}" 
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="Blue"
                               Background="LightYellow"
                               Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,15">
                    <TextBlock Text="{Binding Localization[Progress]}" FontWeight="Bold"/>
                    <ProgressBar Value="{Binding ProgressValue}" 
                                 Minimum="0" Maximum="1"
                                 Height="25"
                                 Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat=P0}" 
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,15">
                    <TextBlock Text="{Binding Localization[CurrentTimeNormal]}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm:ss}" 
                               FontSize="14"
                               Background="LightYellow"
                               Padding="5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Пояснение о невозможности изменения -->
        <Border Grid.Row="3"
                Background="LightCoral"
                BorderBrush="Red"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding Localization[OneWayImportant]}" 
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Localization[OneWayTryChange]}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Localization[OneWayTextBoxNote]}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Localization[OneWayNoChange]}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Элементы для попытки изменения -->
        <GroupBox Header="{Binding Localization[OneWayAttemptGroup]}" 
                  Grid.Row="4"
                  Margin="0,0,0,20" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5">
                    <TextBlock Text="{Binding Localization[TryChangeStatus]}" FontWeight="Bold"/>
                    <TextBox Text="{Binding StatusMessage, Mode=OneWay}" 
                             Margin="0,5,0,10"
                             Padding="5"
                             IsEnabled="True"/>
                    <TextBlock Text="{Binding Localization[OneWayTextBoxWarning]}"
                               Foreground="Red"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,15">
                    <TextBlock Text="{Binding Localization[TryChangeCounter]}" FontWeight="Bold"/>
                    <Slider Minimum="0" Maximum="100" 
                            Value="{Binding Counter, Mode=OneWay}"
                            Margin="0,5,0,10"/>
                    <TextBlock Text="{Binding Localization[OneWaySliderWarning]}"
                               Foreground="Red"
                               FontSize="11"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Пример прямой привязки к элементам интерфейса -->
        <TextBlock Text="{Binding Localization[DirectBindingToUI]}" 
                   Grid.Row="5"
                   FontWeight="Bold"
                   Margin="0,20,0,10"/>

        <StackPanel Grid.Row="6" Margin="0,0,0,0">
            <TextBox x:Name="DirectTextBox" 
                     Text="{Binding Localization[EnterTextHere], Mode=OneWay}"
                     Margin="0,0,0,10"
                     Padding="5"/>
            <TextBlock Text="{Binding Localization[BindingToDirectTextBox]}"/>
            <TextBlock Text="{Binding ElementName=DirectTextBox, Path=Text, Mode=OneWay}" 
                       FontSize="14"
                       Background="LightYellow"
                       Padding="5"/>
        </StackPanel>
    </Grid>
</UserControl>