<UserControl x:Class="MVVM_Lab1.UserControls.OneTimeBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:MVVM_Lab1.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <viewmodels:OneTimeBindingViewModel />
    </UserControl.DataContext>

    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Text="{Binding Localization[OneTimeBindingTitle]}" 
                       Grid.Row="0"
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Пояснение -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Localization[OneTimeBindingDescription]}"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,0,0,15"/>

            <!-- Группа с OneTime привязками -->
            <GroupBox Header="{Binding Localization[OneTimeProperties]}" 
                      Grid.Row="2"
                      Margin="0,0,0,20" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,5">
                        <TextBlock Text="{Binding Localization[StaticText]}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Localization[SystemInitializedText]}" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"
                                   Background="LightGray"
                                   Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,15">
                        <TextBlock Text="{Binding Localization[LoadTime]}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LoadTime, Mode=OneTime, StringFormat=dd.MM.yyyy HH:mm:ss}" 
                                   FontSize="14"
                                   Background="LightGray"
                                   Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,15">
                        <TextBlock Text="{Binding Localization[RandomNumber]}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RandomNumber, Mode=OneTime}" 
                                   FontSize="14"
                                   Background="LightGray"
                                   Padding="5"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" 
                               Text="{Binding Localization[OneTimeWarning]}"
                               Foreground="OrangeRed"
                               FontSize="12"
                               Margin="0,10,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Группа с обычными привязками для сравнения -->
            <GroupBox Header="{Binding Localization[NormalBindingCompare]}" 
                      Grid.Row="3"
                      Margin="0,0,0,20" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[CurrentTimeNormal]}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm:ss}" 
                               FontSize="14"
                               Background="LightGreen"
                               Padding="5"/>
                    <TextBlock Text="{Binding Localization[UpdatesEverySecond]}"
                               Foreground="Green"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Объяснение -->
            <Border Grid.Row="4"
                    Background="LightBlue"
                    BorderBrush="Blue"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[Explanation]}" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Localization[ExplanationText1]}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Localization[ExplanationText2]}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Localization[ExplanationText3]}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Localization[ExplanationText4]}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Пример прямой привязки к элементам интерфейса -->
            <TextBlock Text="{Binding Localization[DirectBindingToUI]}" 
                       Grid.Row="5"
                       FontWeight="Bold"
                       Margin="0,20,0,10"/>

            <StackPanel Grid.Row="6" Margin="0,0,0,0">
                <TextBox x:Name="DirectTextBox" 
                         Text="{Binding Localization[EnterTextHere], Mode=OneWay}"
                         Margin="0,0,0,10"
                         Padding="5"/>
                <TextBlock Text="{Binding Localization[BindingToDirectTextBox]}"/>
                <TextBlock Text="{Binding ElementName=DirectTextBox, Path=Text, Mode=OneTime}" 
                           FontSize="14"
                           Background="LightGray"
                           Padding="5"
                           Margin="0,5,0,10"/>
                <TextBlock Text="{Binding Localization[OneTimeWarning]}"
                           Foreground="OrangeRed"
                           FontSize="11"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>